{
  "name": "react-starter",
  "author": "Daniel Rassomakhin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css",
    "./src/app/**"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checked": "npm run verify && npm run build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "verify": "npm run format:check && npm run lint:check && npm run typecheck && npm run test:coverage && npm run knip",
    "typecheck": "npm run css:types:check && tsc -b",
    "lint": "eslint . --fix --cache --max-warnings 0 && stylelint \"src/**/*.scss\" --fix --cache",
    "lint:check": "eslint . --cache --max-warnings 0 && stylelint \"src/**/*.scss\" --cache && npm run i18n:check && secretlint \"**/*\"",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "css:types": "node scripts/css-module-types.mjs",
    "css:types:check": "node scripts/css-module-types.mjs --check",
    "i18n:check": "node scripts/check-locales.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "size": "node scripts/check-bundle-size.mjs",
    "generate:api": "openapi-typescript ${OPENAPI_SPEC_URL:-./openapi.json} -o src/shared/api/contracts.d.ts",
    "generate:slice": "node scripts/create-slice.mjs",
    "prepare": "husky",
    "patch": "npm version patch -m \"chore(release): v%s\"",
    "minor": "npm version minor -m \"chore(release): v%s\"",
    "major": "npm version major -m \"chore(release): v%s\""
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.6",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "msw": "3.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.9",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.105.1",
    "secretlint": "13.0.6",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-compression2": "2.5.3",
    "vite-plugin-sitemap": "0.8.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
