# Copy to `.env.local` and adjust. All VITE_* variables are validated in src/shared/config/env.ts.

# Base URL of the REST API
VITE_API_BASE_URL=/api

# Public site URL (sitemap.xml, robots.txt)
VITE_SITE_URL=https://example.com

# Mock the API with MSW in development (true | false). Never affects production builds.
VITE_API_MOCKING=true

# OpenAPI spec for `npm run generate:api` (file path or URL)
OPENAPI_SPEC_URL=./openapi.json
